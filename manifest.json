{
  "manifest_version": 3,
  "name": "Kreativ Font Finder",
  "version": "1.0.0",
  "description": "Find fonts on any webpage and search matching results on Kreativ Font.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Kreativ Font Finder"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
